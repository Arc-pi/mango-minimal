{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 0,

    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [],
    "modules-right": [
        "network",
        "cpu",
        "memory",
        "wireplumber",
        "tray",    // Added the system tray right here
        "clock"
    ],

    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "sort-by-id": true,
        "format-icons": {
            "default": "",
            "active": "",
            "urgent": ""
        }
    },

    // System Tray Module Settings
    "tray": {
        "icon-size": 14,    // Keeps the tray icons matching the clean, small text scale
        "spacing": 10       // Adds breathing room between app icons
    },

    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰖪 Off",
        "tooltip-format": "{ifname} via {gwaddr}",
        "max-length": 20
    },

    "cpu": {
        "interval": 2,
        "format": " {usage}%"
    },

    "memory": {
        "interval": 2,
        "format": " {percentage}%",
        "max-length": 10
    },

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": ["󰕿", "󰖀", "󰕾"]
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip": false
    }
}
